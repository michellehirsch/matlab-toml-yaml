{
  "actions": [
    {
      "id": "acme.runChecks",
      "label": "Run Checks",
      "category": "Code",
      "tooltip": "Run Code Analyzer checks",
      "icon": "./icons/checks.svg",
      "command": "acme.runChecks",
      "shortcuts": [
        "Ctrl+Shift+R"
      ],
      "when": "editorLang == 'MATLAB'"
    },
    {
      "id": "acme.autoFormat",
      "label": "Auto Format",
      "category": "Code",
      "tooltip": "Format the current document",
      "icon": "./icons/format.svg",
      "command": "acme.autoFormat",
      "shortcuts": [
        "Ctrl+K",
        "Ctrl+F"
      ],
      "when": "editorActive == true"
    }
  ]
}